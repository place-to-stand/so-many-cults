# Only install versions published at least 7 days ago (supply-chain cooldown).
# Note: `npm update` does not honor this — use `npm install <pkg>@<version>`.
min-release-age=7

# React ships same-day with its scheduler and types, so exempt the whole family.
min-release-age-exclude[]=react
min-release-age-exclude[]=react-dom
min-release-age-exclude[]=scheduler
min-release-age-exclude[]=@types/react
min-release-age-exclude[]=@types/react-dom

# Next.js and Vercel's own packages (published by vercel-release-bot).
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=eslint-config-next
min-release-age-exclude[]=@vercel/*
